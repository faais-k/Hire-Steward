# Development-only placeholder values. Replace the password in your untracked .env.
POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432

# Host-side API and Alembic connection; keep these values aligned with POSTGRES_* above.
DATABASE_URL=postgresql+psycopg://jobpilot:local_dev_only@127.0.0.1:5432/jobpilot

# Candidate-evidence storage must be an absolute path outside this repository.
# Leave empty until a local owner deliberately selects an external data root.
EVIDENCE_STORAGE_ROOT=
# Optional validated limits; application defaults are 10 MiB, 100 MiB, 2, and 3600.
# EVIDENCE_MAX_VERSION_BYTES=10485760
# EVIDENCE_MAX_TOTAL_BYTES=104857600
# EVIDENCE_MAX_CONCURRENT_UPLOADS=2
# EVIDENCE_RECONCILIATION_GRACE_SECONDS=3600
