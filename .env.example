# Development-only placeholder values. Replace the password in your untracked .env.
POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432

# Host-side API and Alembic connection; keep these values aligned with POSTGRES_* above.
DATABASE_URL=postgresql+psycopg://jobpilot:local_dev_only@127.0.0.1:5432/jobpilot
